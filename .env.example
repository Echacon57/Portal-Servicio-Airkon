# Copia este archivo como ".env" para cambiar los valores en tu equipo.
# En Netlify se configuran en Site configuration > Environment variables.
# Las variables deben empezar con VITE_ para que Vite las incluya en el sitio.
# OJO: todo lo que empieza con VITE_ queda visible en el navegador;
# aquí no deben ir llaves secretas.

# API de días feriados (Nager.Date). No requiere llave.
VITE_FERIADOS_API_URL=https://date.nager.at/api/v3
# País en formato ISO 3166-1 alpha-2
VITE_FERIADOS_PAIS=MX
